{
  "name": "dataguide",
  "description": "Prisma's Data Guide",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@mdx-js/react": "2.3.0",
    "algoliasearch": "5.59.0",
    "babel-plugin-styled-components": "2.3.0",
    "fontkit": "2.0.4",
    "gatsby": "5.16.1",
    "gatsby-plugin-algolia": "^1.0.3",
    "gatsby-plugin-catch-links": "5.16.0",
    "gatsby-plugin-google-tagmanager": "5.16.0",
    "gatsby-plugin-image": "3.16.0",
    "gatsby-plugin-mdx": "5.16.0",
    "gatsby-plugin-meta-redirect": "1.1.1",
    "gatsby-plugin-robots-txt": "1.8.0",
    "gatsby-plugin-sharp": "5.16.0",
    "gatsby-plugin-sitemap": "6.16.0",
    "gatsby-plugin-smoothscroll": "1.2.0",
    "gatsby-plugin-styled-components": "6.16.0",
    "gatsby-remark-autolink-headers": "6.16.0",
    "gatsby-remark-copy-linked-files": "6.16.0",
    "gatsby-remark-images": "7.16.0",
    "gatsby-remark-normalize-paths": "1.1.0",
    "gatsby-remark-sectionize": "1.0.0",
    "gatsby-source-filesystem": "5.16.0",
    "gatsby-transformer-sharp": "5.16.0",
    "posthog-js": "^1.434.17",
    "prismjs": "1.30.0",
    "qs": "6.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-feather": "2.0.10",
    "react-instantsearch": "7.50.0",
    "remark-gfm": "3.0.1",
    "remark-mdx": "2.3.0",
    "remark-parse": "10.0.2",
    "remark-stringify": "10.0.3",
    "sharp": "0.32.6",
    "styled-components": "6.5.3",
    "unified": "10.1.2",
    "unist-util-visit": "5.1.0"
  },
  "keywords": [
    "dataguide"
  ],
  "scripts": {
    "clean": "gatsby clean",
    "build": "./scripts/build",
    "dev": "gatsby develop",
    "serve": "npm run build && gatsby serve --prefix-paths -o",
    "prettify": "prettier . --write --check",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'src/**/*.test.ts' 'plugins/**/*.test.mjs'",
    "typecheck": "tsc",
    "postinstall": "husky",
    "install-algolia": "cd ./plugins/gatsby-algolia-indexer && npm install",
    "test:orms": "node experiments/orm-type-safety/run.mjs"
  },
  "devDependencies": {
    "@mdx-js/mdx": "2.3.0",
    "@types/fontkit": "2.0.9",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "is-absolute-url": "5.0.0",
    "lint-staged": "17.6.0",
    "path-browserify": "1.0.1",
    "prettier": "3.9.9",
    "prettier-plugin-prisma": "5.0.0",
    "prism-react-renderer": "2.4.1",
    "remark-sectionize": "1.1.1",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.*": "prettier --write --ignore-unknown"
  }
}
